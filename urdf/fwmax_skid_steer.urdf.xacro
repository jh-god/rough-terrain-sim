<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fwmax">
  <!--
    Gazebo approximation of the FW-max Pro swerve chassis as a four-wheel
    skid-steer vehicle. The detailed DAE remains the visual model; simple
    primitives are used for collision and wheel contact.
  -->

  <xacro:property name="wheel_radius" value="0.125"/>
  <xacro:property name="wheel_width" value="0.080"/>
  <xacro:property name="wheel_visual_radius" value="0.128"/>
  <xacro:property name="wheel_visual_width" value="0.105"/>
  <xacro:property name="wheelbase" value="0.600"/>
  <xacro:property name="wheel_track" value="0.450"/>
  <xacro:property name="base_height" value="0.388"/>
  <xacro:property name="wheel_center_z" value="${wheel_radius - base_height}"/>

  <!--
    At zero suspension travel, the nominal ground plane is base_footprint z=0.
    Keep 1 kg in each carrier and wheel, and place the remaining chassis mass
    so the complete 195.84 kg robot COM is centred 0.255 m above the ground.
  -->
  <xacro:property name="total_mass" value="195.84"/>
  <xacro:property name="target_com_height" value="0.255"/>
  <xacro:property name="suspension_mass" value="1.0"/>
  <xacro:property name="wheel_mass" value="5.0"/>
  <xacro:property
    name="base_mass"
    value="${total_mass - 4.0 * (suspension_mass + wheel_mass)}"/>
  <xacro:property
    name="base_com_z"
    value="${(total_mass * (target_com_height - base_height) - 4.0 * (suspension_mass + wheel_mass) * wheel_center_z) / base_mass}"/>

  <!-- Positive joint travel compresses the wheel upward toward the chassis. -->
  <xacro:property name="suspension_lower_limit" value="-0.030"/>
  <xacro:property name="suspension_upper_limit" value="0.040"/>
  <xacro:property name="suspension_stiffness" value="20000.0"/>
  <xacro:property name="suspension_damping" value="925.0"/>
  <!-- Preload supports the sprung chassis at zero joint travel. -->
  <xacro:property
    name="suspension_reference"
    value="${-(base_mass * 9.81 / 4.0) / suspension_stiffness}"/>
  <xacro:property
    name="nominal_wheel_normal_force"
    value="${total_mass * 9.81 / 4.0}"/>

  <!--
    Total mass is 195.84 kg: 187.84 kg for the chassis, plus a 1 kg suspension
    carrier and a 1 kg wheel at each corner. At the designed loaded equilibrium
    position, the assembled COM is at x=0, y=0, z=-0.133 m in base_link.
  -->

  <material name="fwmax_body_dark_silver">
    <color rgba="0.32 0.34 0.37 1.0"/>
  </material>

  <material name="fwmax_wheel_black">
    <color rgba="0.02 0.02 0.025 1.0"/>
  </material>

  <!-- Keep the inertial base_link below a massless KDL-compatible root. -->
  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${base_com_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <!-- Box approximation based on the 0.96 x 0.55 x 0.395 m envelope. -->
      <inertia
        ixx="${base_mass / 12.0 * (0.55 * 0.55 + 0.395 * 0.395)}"
        ixy="0.0" ixz="0.0"
        iyy="${base_mass / 12.0 * (0.96 * 0.96 + 0.395 * 0.395)}"
        iyz="0.0"
        izz="${base_mass / 12.0 * (0.96 * 0.96 + 0.55 * 0.55)}"/>
    </inertial>

    <visual name="fwmax_dae_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="file://$(find isrl_robot_description)/meshes/isrl_fwmax_pro.dae"
          scale="1 1 1"/>
      </geometry>
      <material name="fwmax_body_dark_silver"/>
    </visual>

    <!-- Keep the expensive detailed DAE out of the contact calculation. -->
    <!-- <collision name="base_collision">
      <origin xyz="0 0 -0.158" rpy="0 0 0"/>
      <geometry>
        <box size="0.76 0.40 0.22"/>
      </geometry>
    </collision> -->
    <collision name="base_collision">
      <origin xyz="0 0 0.032" rpy="0 0 0"/>
      <geometry>
        <box size="0.76 0.40 0.60"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="fwmax_wheel" params="prefix x y">
    <link name="${prefix}_suspension_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${suspension_mass}"/>
        <!-- Compact hub / suspension carrier approximation. -->
        <inertia
          ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}_suspension_joint" type="prismatic">
      <parent link="base_link"/>
      <child link="${prefix}_suspension_link"/>
      <origin xyz="${x} ${y} ${wheel_center_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit
        lower="${suspension_lower_limit}"
        upper="${suspension_upper_limit}"
        effort="5000.0" velocity="2.0"/>
      <dynamics damping="${suspension_damping}" friction="0.0"/>
    </joint>

    <!-- These Gazebo extensions become SDF joint-axis spring dynamics. -->
    <gazebo reference="${prefix}_suspension_joint">
      <springReference>${suspension_reference}</springReference>
      <springStiffness>${suspension_stiffness}</springStiffness>
    </gazebo>

    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <!-- Cylinder inertia with its rotation axis along link-frame y. -->
        <inertia
          ixx="0.004439583" ixy="0.0" ixz="0.0"
          iyy="0.007812500" iyz="0.0" izz="0.004439583"/>
      </inertial>

      <!--
        This primitive slightly oversizes the wheels already present in the
        full-body DAE so the moving black wheel masks the fixed mesh wheel.
      -->
      <visual name="wheel_visual">
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_visual_radius}" length="${wheel_visual_width}"/>
        </geometry>
        <material name="fwmax_wheel_black"/>
      </visual>

      <collision name="wheel_collision">
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_suspension_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="800.0" velocity="20.0"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>

  </xacro:macro>

  <xacro:fwmax_wheel
    prefix="front_left" x="${wheelbase / 2.0}" y="${wheel_track / 2.0}"/>
  <xacro:fwmax_wheel
    prefix="rear_left" x="${-wheelbase / 2.0}" y="${wheel_track / 2.0}"/>
  <xacro:fwmax_wheel
    prefix="front_right" x="${wheelbase / 2.0}" y="${-wheel_track / 2.0}"/>
  <xacro:fwmax_wheel
    prefix="rear_right" x="${-wheelbase / 2.0}" y="${-wheel_track / 2.0}"/>

  <gazebo>
    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <min_linear_acceleration>-0.8</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <min_angular_acceleration>-1.5</min_angular_acceleration>
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_linear_velocity>-2.0</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
    </plugin>

    <plugin
      filename="libignition-gazebo-joint-state-publisher-system.so"
      name="ignition::gazebo::systems::JointStatePublisher"/>

    <!-- Lateral compliance is required for a fixed-wheel chassis to turn. -->
    <plugin
      filename="libignition-gazebo-wheel-slip-system.so"
      name="ignition::gazebo::systems::WheelSlip">
      <wheel link_name="front_left_wheel_link">
        <slip_compliance_lateral>0.2</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.1</slip_compliance_longitudinal>
        <wheel_normal_force>${nominal_wheel_normal_force}</wheel_normal_force>
        <wheel_radius>${wheel_radius}</wheel_radius>
      </wheel>
      <wheel link_name="rear_left_wheel_link">
        <slip_compliance_lateral>0.2</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.1</slip_compliance_longitudinal>
        <wheel_normal_force>${nominal_wheel_normal_force}</wheel_normal_force>
        <wheel_radius>${wheel_radius}</wheel_radius>
      </wheel>
      <wheel link_name="front_right_wheel_link">
        <slip_compliance_lateral>0.2</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.1</slip_compliance_longitudinal>
        <wheel_normal_force>${nominal_wheel_normal_force}</wheel_normal_force>
        <wheel_radius>${wheel_radius}</wheel_radius>
      </wheel>
      <wheel link_name="rear_right_wheel_link">
        <slip_compliance_lateral>0.2</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.1</slip_compliance_longitudinal>
        <wheel_normal_force>${nominal_wheel_normal_force}</wheel_normal_force>
        <wheel_radius>${wheel_radius}</wheel_radius>
      </wheel>
    </plugin>
  </gazebo>
</robot>
