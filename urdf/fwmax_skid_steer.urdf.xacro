<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fwmax">
  <!--
    Gazebo approximation of the FW-max Pro chassis. drive_mode selects either
    the legacy four-wheel skid-steer approximation or Gear 6 dual-Ackermann
    steering. The detailed DAE remains the visual model; simple primitives are
    used for collision and wheel contact.
  -->

  <xacro:arg name="namespace" default=""/>
  <xacro:arg name="is_sim" default="true"/>
  <xacro:arg name="drive_mode" default="skid"/>
  <xacro:arg
    name="controllers_file"
    default=""/>

  <xacro:property name="drive_mode" value="$(arg drive_mode)"/>

  <xacro:include
    filename="$(find clearpath_sensors_description)/urdf/ouster_os1.urdf.xacro"/>
  <xacro:include
    filename="$(find clearpath_sensors_description)/urdf/intel_realsense.urdf.xacro"/>

  <xacro:property name="wheel_radius" value="0.125"/>
  <xacro:property name="wheel_width" value="0.080"/>
  <xacro:property name="wheel_visual_radius" value="0.128"/>
  <xacro:property name="wheel_visual_width" value="0.105"/>
  <xacro:property name="wheelbase" value="0.600"/>
  <xacro:property name="wheel_track" value="0.450"/>
  <xacro:property name="base_height" value="0.388"/>
  <xacro:property name="wheel_center_z" value="${wheel_radius - base_height}"/>

  <!--
    At zero suspension travel, the nominal ground plane is base_footprint z=0.
    Keep 1 kg in each suspension / steering carrier and 5 kg in each wheel,
    and place the remaining chassis mass so the complete 195.84 kg robot COM
    is centred 0.255 m above the ground.
  -->
  <xacro:property name="total_mass" value="195.84"/>
  <xacro:property name="target_com_height" value="0.255"/>
  <xacro:property name="suspension_mass" value="0.5"/>
  <xacro:property name="steering_mass" value="0.5"/>
  <xacro:property name="wheel_mass" value="5.0"/>
  <xacro:property
    name="base_mass"
    value="${total_mass - 4.0 * (suspension_mass + steering_mass + wheel_mass)}"/>
  <xacro:property
    name="base_com_z"
    value="${(total_mass * (target_com_height - base_height) - 4.0 * (suspension_mass + steering_mass + wheel_mass) * wheel_center_z) / base_mass}"/>

  <!-- Positive joint travel compresses the wheel upward toward the chassis. -->
  <xacro:property name="suspension_lower_limit" value="-0.030"/>
  <xacro:property name="suspension_upper_limit" value="0.040"/>
  <xacro:property name="suspension_stiffness" value="20000.0"/>
  <xacro:property name="suspension_damping" value="925.0"/>
  <!-- Preload supports the sprung chassis at zero joint travel. -->
  <xacro:property
    name="suspension_reference"
    value="${-(base_mass * 9.81 / 4.0) / suspension_stiffness}"/>
  <xacro:property
    name="nominal_wheel_normal_force"
    value="${total_mass * 9.81 / 4.0}"/>
  <xacro:property
    name="slip_compliance_lateral"
    value="${0.02 if drive_mode == 'swerve' else 0.2}"/>

  <!--
    Total mass is 195.84 kg: 171.84 kg for the chassis, plus a 0.5 kg
    suspension carrier, 0.5 kg steering carrier, and 5 kg wheel at each corner.
    At the designed loaded equilibrium position, the assembled COM is at x=0,
    y=0, z=-0.133 m in base_link.
  -->

  <material name="fwmax_body_dark_silver">
    <color rgba="0.32 0.34 0.37 1.0"/>
  </material>

  <material name="fwmax_wheel_black">
    <color rgba="0.02 0.02 0.025 1.0"/>
  </material>

  <!-- Keep the inertial base_link below a massless KDL-compatible root. -->
  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${base_com_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <!-- Box approximation based on the 0.96 x 0.55 x 0.395 m envelope. -->
      <inertia
        ixx="${base_mass / 12.0 * (0.55 * 0.55 + 0.395 * 0.395)}"
        ixy="0.0" ixz="0.0"
        iyy="${base_mass / 12.0 * (0.96 * 0.96 + 0.395 * 0.395)}"
        iyz="0.0"
        izz="${base_mass / 12.0 * (0.96 * 0.96 + 0.55 * 0.55)}"/>
    </inertial>

    <visual name="fwmax_dae_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="file://$(find rough_terrain_sim)/meshes/fwmax/isrl_fwmax_pro.dae"
          scale="1 1 1"/>
      </geometry>
      <material name="fwmax_body_dark_silver"/>
    </visual>

    <!-- Keep the expensive detailed DAE out of the contact calculation. -->
    <!-- <collision name="base_collision">
      <origin xyz="0 0 -0.158" rpy="0 0 0"/>
      <geometry>
        <box size="0.76 0.40 0.22"/>
      </geometry>
    </collision> -->
    <collision name="base_collision">
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.76 0.40 0.80"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <!--
    Ouster OS1-64. The imported model places its measurement frame 0.060695 m
    above the mounting origin (base height 0.0225 m + sensor offset 0.038195 m).
    Offset the mount so the requested os_sensor frame is exactly at
    xyz="0.32 0.0 0.505" relative to base_link.
  -->
  <xacro:ouster_os1
    name="os1_64"
    parent_link="base_link"
    samples_v="64">
    <origin
      xyz="0.32 0.0 0.505"
      rpy="0.0 0.0 0.0"/>
  </xacro:ouster_os1>

  <!-- Alias the imported Ouster measurement frame to the requested name. -->
  <link name="os_sensor"/>
  <joint name="os_sensor_joint" type="fixed">
    <parent link="os1_64_sensor_link"/>
    <child link="os_sensor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!--
    RealSense D435. Its imported macro defines camera_link 0.0106, 0.0175,
    0.0125 m from the bottom-screw frame. Compensate that internal offset so
    base_link -> camera_link is exactly xyz="0.41 0.01 0.335" and
    rpy="0.0 0.7854 0.0".
  -->
  <xacro:property name="camera_pitch" value="0.7854"/>
  <xacro:property name="camera_internal_x" value="0.0106"/>
  <xacro:property name="camera_internal_y" value="0.0175"/>
  <xacro:property name="camera_internal_z" value="0.0125"/>
  <xacro:property
    name="camera_mount_x"
    value="${0.41 - (cos(camera_pitch) * camera_internal_x + sin(camera_pitch) * camera_internal_z)}"/>
  <xacro:property
    name="camera_mount_y"
    value="${0.01 - camera_internal_y}"/>
  <xacro:property
    name="camera_mount_z"
    value="${0.335 - (-sin(camera_pitch) * camera_internal_x + cos(camera_pitch) * camera_internal_z)}"/>
  <xacro:intel_realsense name="camera" parent_link="base_link">
    <origin
      xyz="${camera_mount_x} ${camera_mount_y} ${camera_mount_z}"
      rpy="0.0 ${camera_pitch} 0.0"/>
  </xacro:intel_realsense>

  <xacro:macro name="fwmax_wheel" params="prefix x y">
    <link name="${prefix}_suspension_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${suspension_mass}"/>
        <!-- Compact hub / suspension carrier approximation. -->
        <inertia
          ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}_suspension_joint" type="prismatic">
      <parent link="base_link"/>
      <child link="${prefix}_suspension_link"/>
      <origin xyz="${x} ${y} ${wheel_center_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit
        lower="${suspension_lower_limit}"
        upper="${suspension_upper_limit}"
        effort="5000.0" velocity="2.0"/>
      <dynamics damping="${suspension_damping}" friction="0.0"/>
    </joint>

    <!-- These Gazebo extensions become SDF joint-axis spring dynamics. -->
    <gazebo reference="${prefix}_suspension_joint">
      <springReference>${suspension_reference}</springReference>
      <springStiffness>${suspension_stiffness}</springStiffness>
    </gazebo>

    <link name="${prefix}_steering_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${steering_mass}"/>
        <inertia
          ixx="0.0005" ixy="0.0" ixz="0.0"
          iyy="0.0005" iyz="0.0" izz="0.0005"/>
      </inertial>
    </link>

    <xacro:if value="${drive_mode == 'swerve'}">
      <joint name="${prefix}_steering_joint" type="continuous">
        <parent link="${prefix}_suspension_link"/>
        <child link="${prefix}_steering_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="1200.0" velocity="2.5"/>
        <dynamics damping="0.5" friction="0.0"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${drive_mode == 'swerve'}">
      <joint name="${prefix}_steering_joint" type="fixed">
        <parent link="${prefix}_suspension_link"/>
        <child link="${prefix}_steering_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:unless>

    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <!-- Cylinder inertia with its rotation axis along link-frame y. -->
        <inertia
          ixx="0.004439583" ixy="0.0" ixz="0.0"
          iyy="0.007812500" iyz="0.0" izz="0.004439583"/>
      </inertial>

      <!--
        This primitive slightly oversizes the wheels already present in the
        full-body DAE so the moving black wheel masks the fixed mesh wheel.
      -->
      <visual name="wheel_visual">
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_visual_radius}" length="${wheel_visual_width}"/>
        </geometry>
        <material name="fwmax_wheel_black"/>
      </visual>

      <collision name="wheel_collision">
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="800.0" velocity="20.0"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>

  </xacro:macro>

  <xacro:fwmax_wheel
    prefix="front_left" x="${wheelbase / 2.0}" y="${wheel_track / 2.0}"/>
  <xacro:fwmax_wheel
    prefix="rear_left" x="${-wheelbase / 2.0}" y="${wheel_track / 2.0}"/>
  <xacro:fwmax_wheel
    prefix="front_right" x="${wheelbase / 2.0}" y="${-wheel_track / 2.0}"/>
  <xacro:fwmax_wheel
    prefix="rear_right" x="${-wheelbase / 2.0}" y="${-wheel_track / 2.0}"/>

  <xacro:if value="${drive_mode == 'swerve'}">
    <ros2_control name="fwmax_swerve_system" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="front_left_steering_joint">
        <command_interface name="velocity">
          <param name="min">-2.5</param>
          <param name="max">2.5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="front_right_steering_joint">
        <command_interface name="velocity">
          <param name="min">-2.5</param>
          <param name="max">2.5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="rear_left_steering_joint">
        <command_interface name="velocity">
          <param name="min">-2.5</param>
          <param name="max">2.5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="rear_right_steering_joint">
        <command_interface name="velocity">
          <param name="min">-2.5</param>
          <param name="max">2.5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="front_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="front_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="rear_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="rear_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:if>

  <gazebo>
    <xacro:unless value="${drive_mode == 'swerve'}">
      <plugin
        filename="libignition-gazebo-diff-drive-system.so"
        name="ignition::gazebo::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>${wheel_track}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_acceleration>0.8</max_linear_acceleration>
        <min_linear_acceleration>-0.8</min_linear_acceleration>
        <max_angular_acceleration>1.5</max_angular_acceleration>
        <min_angular_acceleration>-1.5</min_angular_acceleration>
        <max_linear_velocity>2.0</max_linear_velocity>
        <min_linear_velocity>-2.0</min_linear_velocity>
        <max_angular_velocity>1.5</max_angular_velocity>
        <min_angular_velocity>-1.5</min_angular_velocity>
      </plugin>
    </xacro:unless>

    <xacro:if value="${drive_mode == 'swerve'}">
      <plugin
        filename="libign_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
        <robot_param>robot_description</robot_param>
        <robot_param_node>fwmax_robot_state_publisher</robot_param_node>
      </plugin>
      <plugin
        filename="libignition-gazebo-odometry-publisher-system.so"
        name="ignition::gazebo::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_topic>/ground_truth/odom</odom_topic>
        <tf_topic>/ground_truth/tf</tf_topic>
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </xacro:if>

    <plugin
      filename="libignition-gazebo-joint-state-publisher-system.so"
      name="ignition::gazebo::systems::JointStatePublisher"/>

    <!-- Skid mode needs lateral slip; swerve mode uses lower compliance. -->
    <plugin
      filename="libignition-gazebo-wheel-slip-system.so"
      name="ignition::gazebo::systems::WheelSlip">
      <wheel link_name="front_left_wheel_link">
        <slip_compliance_lateral>${slip_compliance_lateral}</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.1</slip_compliance_longitudinal>
        <wheel_normal_force>${nominal_wheel_normal_force}</wheel_normal_force>
        <wheel_radius>${wheel_radius}</wheel_radius>
      </wheel>
      <wheel link_name="rear_left_wheel_link">
        <slip_compliance_lateral>${slip_compliance_lateral}</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.1</slip_compliance_longitudinal>
        <wheel_normal_force>${nominal_wheel_normal_force}</wheel_normal_force>
        <wheel_radius>${wheel_radius}</wheel_radius>
      </wheel>
      <wheel link_name="front_right_wheel_link">
        <slip_compliance_lateral>${slip_compliance_lateral}</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.1</slip_compliance_longitudinal>
        <wheel_normal_force>${nominal_wheel_normal_force}</wheel_normal_force>
        <wheel_radius>${wheel_radius}</wheel_radius>
      </wheel>
      <wheel link_name="rear_right_wheel_link">
        <slip_compliance_lateral>${slip_compliance_lateral}</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.1</slip_compliance_longitudinal>
        <wheel_normal_force>${nominal_wheel_normal_force}</wheel_normal_force>
        <wheel_radius>${wheel_radius}</wheel_radius>
      </wheel>
    </plugin>
  </gazebo>
</robot>
