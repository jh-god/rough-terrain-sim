<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="rough_terrain">
    <static>true</static>
    <link name="terrain_link">
      <collision name="terrain_collision">
        <geometry>
          <heightmap>
            <uri>model://rough_terrain/heightmaps/rough_terrain.png</uri>
            <!-- Physical dimensions: 50 m x 50 m, with 2 m total elevation range. -->
            <size>50 50 4</size>
            <pos>0 0 0</pos>
            <use_terrain_paging>false</use_terrain_paging>
          </heightmap>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="terrain_visual">
        <cast_shadows>true</cast_shadows>
        <geometry>
          <heightmap>
            <uri>model://rough_terrain/heightmaps/rough_terrain.png</uri>
            <size>50 50 4</size>
            <pos>0 0 0</pos>
            <use_terrain_paging>false</use_terrain_paging>
            <!-- Ogre2 terrain shader requires at least one diffuse/normal layer. -->
            <texture>
              <!-- 1254 px photorealistic dirt albedo and a derived normal map. -->
              <diffuse>model://rough_terrain/textures/dirt_realistic.png</diffuse>
              <normal>model://rough_terrain/textures/dirt_realistic_normal.png</normal>
              <!-- Repeat the texture every 6 m across the heightmap. -->
              <size>6</size>
            </texture>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
