<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="rough_terrain_world">
    <gravity>0 0 -9.81</gravity>

    <physics name="fortress_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gui>
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <!-- x y z roll pitch yaw -->
        <camera_pose>-14 -5.5 7 0 0.65 0</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
    </gui>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so"
        name="ignition::gazebo::systems::Imu"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <include>
      <uri>model://rough_terrain</uri>
    </include>

    <!-- Four loose obstacle groves. Pose heights are bilinearly sampled from
         the Y-flipped heightmap; rocks and roots are slightly embedded. -->
    <!-- Northwest grove. -->
    <include>
      <name>tree_01</name>
      <uri>model://tree</uri>
      <pose>-14.68 10.17 1.245 0 0 -0.98</pose>
    </include>
    <include>
      <name>tree_02</name>
      <uri>model://tree</uri>
      <pose>-11.46 9.86 1.245 0 0 -2.93</pose>
    </include>
    <include>
      <name>tree_03</name>
      <uri>model://tree</uri>
      <pose>-9.86 3.08 2.012 0 0 1.74</pose>
    </include>
    <include>
      <name>tree_04</name>
      <uri>model://tree</uri>
      <pose>-8.88 6.69 1.245 0 0 -0.76</pose>
    </include>
    <include>
      <name>tree_05</name>
      <uri>model://tree</uri>
      <pose>-18.29 3.68 1.811 0 0 -0.98</pose>
    </include>
    <include>
      <name>tree_stump_01</name>
      <uri>model://tree_stump</uri>
      <pose>-14.00 3.62 1.425 0 0 1.98</pose>
    </include>
    <include>
      <name>boulder_01_01</name>
      <uri>model://boulder_01</uri>
      <pose>-17.95 16.09 2.556 0 0 2.73</pose>
    </include>
    <include>
      <name>boulder_01_02</name>
      <uri>model://boulder_01</uri>
      <pose>-14.87 17.74 1.305 0 0 -0.86</pose>
    </include>
    <include>
      <name>boulder_01_03</name>
      <uri>model://boulder_01</uri>
      <pose>-15.09 7.55 1.305 0 0 1.79</pose>
    </include>

    <!-- Northeast grove. -->
    <include>
      <name>tree_06</name>
      <uri>model://tree</uri>
      <pose>11.76 8.76 1.245 0 0 0.59</pose>
    </include>
    <include>
      <name>tree_07</name>
      <uri>model://tree</uri>
      <pose>6.81 15.86 1.245 0 0 2.71</pose>
    </include>
    <include>
      <name>tree_08</name>
      <uri>model://tree</uri>
      <pose>11.33 16.88 1.282 0 0 0.44</pose>
    </include>
    <include>
      <name>tree_09</name>
      <uri>model://tree</uri>
      <pose>12.57 12.73 2.170 0 0 0.32</pose>
    </include>
    <include>
      <name>tree_10</name>
      <uri>model://tree</uri>
      <pose>5.07 12.95 1.245 0 0 -1.88</pose>
    </include>
    <include>
      <name>tree_stump_02</name>
      <uri>model://tree_stump</uri>
      <pose>17.06 7.93 2.444 0 0 -0.15</pose>
    </include>
    <include>
      <name>boulder_01_04</name>
      <uri>model://boulder_01</uri>
      <pose>8.74 14.06 1.305 0 0 0.69</pose>
    </include>
    <include>
      <name>boulder_01_05</name>
      <uri>model://boulder_01</uri>
      <pose>3.47 7.66 2.721 0 0 0.20</pose>
    </include>
    <include>
      <name>namaqualand_boulder_02_01</name>
      <uri>model://namaqualand_boulder_02</uri>
      <pose>10.10 1.14 2.714 0 0 -0.64</pose>
    </include>

    <!-- Southeast grove. -->
    <include>
      <name>tree_11</name>
      <uri>model://tree</uri>
      <pose>11.04 -10.22 2.029 0 0 -1.20</pose>
    </include>
    <include>
      <name>tree_12</name>
      <uri>model://tree</uri>
      <pose>11.46 -13.46 2.268 0 0 -2.60</pose>
    </include>
    <include>
      <name>tree_13</name>
      <uri>model://tree</uri>
      <pose>8.78 -8.15 1.298 0 0 -0.85</pose>
    </include>
    <include>
      <name>tree_14</name>
      <uri>model://tree</uri>
      <pose>8.30 -14.94 2.247 0 0 -0.50</pose>
    </include>
    <include>
      <name>tree_15</name>
      <uri>model://tree</uri>
      <pose>11.56 -2.19 1.754 0 0 -1.58</pose>
    </include>
    <include>
      <name>tree_stump_03</name>
      <uri>model://tree_stump</uri>
      <pose>13.51 -11.28 1.425 0 0 0.14</pose>
    </include>
    <include>
      <name>boulder_01_06</name>
      <uri>model://boulder_01</uri>
      <pose>16.24 -14.58 1.305 0 0 -2.47</pose>
    </include>
    <include>
      <name>boulder_01_07</name>
      <uri>model://boulder_01</uri>
      <pose>4.02 -13.28 2.435 0 0 -1.73</pose>
    </include>
    <include>
      <name>boulder_01_08</name>
      <uri>model://boulder_01</uri>
      <pose>8.56 -19.39 2.211 0 0 -0.85</pose>
    </include>
    <include>
      <name>namaqualand_boulder_02_02</name>
      <uri>model://namaqualand_boulder_02</uri>
      <pose>19.48 -10.52 1.295 0 0 -1.95</pose>
    </include>

    <!-- Southwest grove. -->
    <include>
      <name>tree_16</name>
      <uri>model://tree</uri>
      <pose>-12.83 -13.52 1.245 0 0 0.28</pose>
    </include>
    <include>
      <name>tree_17</name>
      <uri>model://tree</uri>
      <pose>-15.93 -19.08 1.245 0 0 1.04</pose>
    </include>
    <include>
      <name>tree_18</name>
      <uri>model://tree</uri>
      <pose>-16.93 -13.19 1.304 0 0 -0.28</pose>
    </include>
    <include>
      <name>tree_19</name>
      <uri>model://tree</uri>
      <pose>-7.62 -17.96 2.160 0 0 1.03</pose>
    </include>
    <include>
      <name>tree_20</name>
      <uri>model://tree</uri>
      <pose>-15.18 -10.69 1.881 0 0 0.31</pose>
    </include>
    <include>
      <name>tree_stump_04</name>
      <uri>model://tree_stump</uri>
      <pose>-8.62 -11.38 2.617 0 0 -2.62</pose>
    </include>
    <include>
      <name>tree_stump_05</name>
      <uri>model://tree_stump</uri>
      <pose>-14.11 -16.99 1.487 0 0 -3.13</pose>
